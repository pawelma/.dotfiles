{
  "permissions": {
    "allow": [
      "Read(~/projects/**)",
      "Read(~/.claude/**)",
      "Edit(~/projects/**)",
      "Write(~/projects/**)",
      "Glob",
      "Grep",
      "Bash(*)",
      "WebFetch(domain:*)",
      "WebSearch"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Bash(rm -rf /*)",
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y ccstatusline@latest --hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y ccstatusline@latest --hook"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/pawel.madejski/projects/github/pawelma/.dotfiles/config/claude/hooks/session-title-review.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest"
  },
  "enabledPlugins": {
    "ruby-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.atlassian.net",
        "mcp.context7.com",
        "mcp.figma.com",
        "rubygems.org",
        "registry.npmjs.org"
      ],
      "allowAllUnixSockets": true,
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowRead": [
        "~/.ssh/known_hosts",
        "~/.ssh/config",
        "~/.config/gh",
        "/System/Library/Keychains",
        "/Library/Keychains",
        "/private/etc/ssl",
        "/etc/ssl"
      ]
    },
    "excludedCommands": [
      "acli *"
    ]
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "editorMode": "normal",
  "autoScrollEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "git push (non-force) to any remote or branch",
      "gh CLI commands for GitHub operations (PRs, issues, checks, releases)",
      "acli CLI commands for Jira operations (view, search, create, edit, comment, transition)",
      "Running test suites (rspec, bundle exec rspec, rake spec, minitest)",
      "bundle exec commands for Ruby project tooling",
      "rake tasks",
      "Running linters and formatters (rubocop, eslint, prettier)",
      "npm and yarn commands (install, test, build, run)",
      "Docker and docker-compose commands for local development",
      "curl and wget for fetching data",
      "Local development server commands"
    ]
  }
}
